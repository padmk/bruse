{
  "manifest_version": 3,
  "name": "Browser Control Bridge",
  "description": "Lets local agents read and operate browser tabs through a local MCP server.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "history",
    "downloads",
    "scripting",
    "offscreen",
    "bookmarks"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
