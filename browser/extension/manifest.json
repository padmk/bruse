{
  "manifest_version": 3,
  "name": "Bruse",
  "description": "Browser use for local AI agents: reads and operates your tabs in the background.",
  "version": "0.18.6",
  "homepage_url": "https://github.com/padmk/bruse",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "downloads",
    "scripting",
    "offscreen",
    "webNavigation"
  ],
  "optional_permissions": [
    "history",
    "bookmarks"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bruse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
